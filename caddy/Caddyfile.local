# Local network — self-signed certificate.
#
# Replace myserver.local with your server's hostname. Caddy generates its own
# certificate authority and issues a certificate for this hostname; no domain
# or internet connectivity is required.
myserver.local {
    tls internal
    reverse_proxy app:8080
}

# After the first run, trust Caddy's root CA on each device so browsers stop
# warning about the self-signed certificate.
#
# 1. Extract the root certificate from the running Caddy container:
#
#        docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt ./caddy-root.crt
#
# 2. Trust caddy-root.crt on each device:
#
#    macOS    Double-click caddy-root.crt → Keychain Access → find the
#             "Caddy Local Authority" certificate → expand "Trust" →
#             set "When using this certificate" to "Always Trust".
#
#    iPhone   AirDrop caddy-root.crt to the device → Settings → "Profile
#    / iPad   Downloaded" → Install. Then Settings → General → About →
#             Certificate Trust Settings → enable full trust for the Caddy
#             certificate.
#
#    Linux    sudo cp caddy-root.crt /usr/local/share/ca-certificates/
#             sudo update-ca-certificates
