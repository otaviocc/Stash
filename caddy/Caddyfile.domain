# Internet-exposed — real domain with automatic Let's Encrypt.
#
# Replace with your actual domain. Caddy obtains and renews the certificate
# automatically — nothing else needed.
stash.yourdomain.com {
    reverse_proxy app:8080
}

# Before starting Caddy with this configuration:
#
#   - The server must be reachable from the internet on ports 80 and 443
#     (forward both through your router/firewall to this host).
#   - DNS for stash.yourdomain.com must already point to the server's public
#     IP address — Caddy validates domain ownership over HTTP/TLS on first run.
#   - Caddy handles certificate issuance and renewal automatically; there is
#     nothing to install, configure, or rotate by hand.
