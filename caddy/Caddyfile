# Active Caddy configuration — this is the file Caddy actually reads (mounted by
# docker-compose.caddy.yml as /etc/caddy/Caddyfile).
#
# It ships as a copy of Caddyfile.local (local network, self-signed certificate).
# To switch setups, copy the example you want over this file and edit the
# hostname/domain:
#
#     cp caddy/Caddyfile.local  caddy/Caddyfile   # local network, self-signed
#     cp caddy/Caddyfile.domain caddy/Caddyfile   # internet, Let's Encrypt
#
# See README.md in this directory for the full walkthrough.

# Replace myserver.local with your server's hostname.
myserver.local {
    tls internal
    reverse_proxy app:8080
}
