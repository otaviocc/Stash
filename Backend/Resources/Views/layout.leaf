<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Apply the saved theme before any CSS/paint to avoid a flash of the wrong theme. -->
    <script>
    (function () {
        var m = document.cookie.match(/(?:^|; )stash_theme=([^;]+)/);
        if (m && (m[1] === 'dark' || m[1] === 'light')) {
            document.documentElement.setAttribute('data-theme', m[1]);
        }
    })();
    </script>
    <title>#if(adminUsername):Stash Admin#else:Stash#endif — #(title)</title>
    <link rel="stylesheet" href="/css/stash.css">
    #import("css")
    <!-- Accent theme override from SiteSettings (Site Settings & Admin Customisation). -->
    <style>
        :root { --accent: #(chrome.accentLight); }
        [data-theme="dark"] { --accent: #(chrome.accentDark); }
        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]):not([data-theme="dark"]) { --accent: #(chrome.accentDark); }
        }
    </style>
</head>
<body>
    #if(adminUsername):
    <header class="nav">
        <a href="/admin" class="brand">Stash Admin</a>
        <nav>
            <a href="/admin">Dashboard</a>
            <a href="/admin/users">Users</a>
            <a href="/admin/users/new">New user</a>
            <a href="/admin/appearance">Appearance</a>
            <a href="/app">App</a>
        </nav>
        <span class="spacer"></span>
        <span class="who">#(adminUsername)</span>
        <form method="post" action="/admin/logout">
            <button class="secondary" type="submit">Log out</button>
        </form>
    </header>
    #endif
    #if(appUsername):
    <header class="nav">
        <a href="/app" class="brand">Stash</a>
        <nav>
            <a href="/app">Bookmarks</a>
            <a href="/app/bookmarks/new">Add</a>
            <a href="/app/tags">Tags</a>
            <a href="/app/smart-views">Smart Views</a>
            <a href="/app/settings">Settings</a>
            #if(appIsAdmin):<a href="/admin">Dashboard</a>#endif
        </nav>
        <span class="spacer"></span>
        <span class="who">#(appUsername)</span>
        <form method="post" action="/app/logout">
            <button class="secondary" type="submit">Log out</button>
        </form>
    </header>
    #endif
    <main>
        #import("content")
    </main>
    #extend("_footer")
    <script>
    // Dependency-free, reusable tag autocomplete. `multi` (default true) does comma-segment
    // completion for the bookmark tag fields; single mode replaces the whole value (used by the
    // Smart View tag conditions). `enabled` gates whether suggestions appear at all (so the Smart
    // View value input only autocompletes while its row's type is "tag").
    window.stashTagAutocomplete = function (input, known, opts) {
        opts = opts || {};
        var multi = opts.multi !== false;
        var enabled = opts.enabled || function () { return true; };
        if (!known || !known.length) return;
        var box = document.createElement('div');
        box.className = 'tag-suggest';
        input.insertAdjacentElement('afterend', box);
        var active = -1;
        function segIndex() { return multi ? input.value.slice(0, input.selectionStart).split(',').length - 1 : 0; }
        function frag() { return (multi ? (input.value.split(',')[segIndex()] || '') : input.value).trim().toLowerCase(); }
        function choose(tag) {
            if (multi) {
                var segs = input.value.split(',');
                segs[segIndex()] = (segIndex() > 0 ? ' ' : '') + tag;
                input.value = segs.join(',') + ', ';
            } else {
                input.value = tag;
            }
            box.style.display = 'none';
            input.focus();
            input.setSelectionRange(input.value.length, input.value.length);
        }
        function render() {
            if (!enabled()) { box.style.display = 'none'; return; }
            var f = frag();
            box.innerHTML = ''; active = -1;
            var hits = f ? known.filter(function (t) { return t !== f && t.split('/').some(function (seg) { return seg.indexOf(f) === 0; }); }).slice(0, 8) : [];
            if (!hits.length) { box.style.display = 'none'; return; }
            hits.forEach(function (t) {
                var el = document.createElement('div');
                el.className = 'tag-suggest-item';
                el.textContent = t;
                el.addEventListener('mousedown', function (e) { e.preventDefault(); choose(t); });
                box.appendChild(el);
            });
            box.style.display = 'block';
        }
        input.addEventListener('input', render);
        input.addEventListener('keydown', function (e) {
            var items = box.querySelectorAll('.tag-suggest-item');
            if (box.style.display === 'none' || !items.length) return;
            if (e.key === 'ArrowDown') { active = Math.min(active + 1, items.length - 1); }
            else if (e.key === 'ArrowUp') { active = Math.max(active - 1, 0); }
            else if (e.key === 'Escape') { box.style.display = 'none'; return; }
            else if ((e.key === 'Enter' || e.key === 'Tab') && active >= 0) { choose(items[active].textContent); e.preventDefault(); return; }
            else return;
            e.preventDefault();
            items.forEach(function (it, j) { it.classList.toggle('active', j === active); });
        });
        input.addEventListener('blur', function () { setTimeout(function () { box.style.display = 'none'; }, 150); });
    };

    document.querySelectorAll('input[data-known-tags]').forEach(function (input) {
        var known = [];
        try { known = JSON.parse(input.getAttribute('data-known-tags')) || []; } catch (e) { return; }
        window.stashTagAutocomplete(input, known, { multi: true });
    });
    </script>
</body>
</html>
