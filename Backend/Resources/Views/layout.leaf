<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Apply the saved theme before any CSS/paint to avoid a flash of the wrong theme. -->
    <script>
    (function () {
        var m = document.cookie.match(/(?:^|; )stash_theme=([^;]+)/);
        if (m && (m[1] === 'dark' || m[1] === 'light')) {
            document.documentElement.setAttribute('data-theme', m[1]);
        }
    })();
    </script>
    <title>#if(adminUsername):Stash Admin#else:Stash#endif — #(title)</title>
    <link rel="stylesheet" href="/css/stash.css">
    #import("css")
    <!-- Accent theme override from SiteSettings (Site Settings & Admin Customisation). -->
    <style>
        :root { --accent: #(chrome.accentLight); }
        [data-theme="dark"] { --accent: #(chrome.accentDark); }
        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]):not([data-theme="dark"]) { --accent: #(chrome.accentDark); }
        }
    </style>
    <!-- Shared tag autocomplete; deferred so it runs after parse and before any page script. -->
    <script defer src="/js/tag-autocomplete.js"></script>
    #import("scripts")
</head>
<body>
    #if(adminUsername):
    <header class="nav">
        <a href="/admin" class="brand">Stash Admin</a>
        <nav>
            <a href="/admin">Dashboard</a>
            <a href="/admin/users">Users</a>
            <a href="/admin/users/new">New user</a>
            <a href="/admin/appearance">Appearance</a>
            <a href="/app">App</a>
        </nav>
        <span class="spacer"></span>
        <span class="who">#(adminUsername)</span>
        <form method="post" action="/admin/logout">
            <button class="secondary" type="submit">Log out</button>
        </form>
    </header>
    #endif
    #if(appUsername):
    <header class="nav">
        <a href="/app" class="brand">Stash</a>
        <nav>
            <a href="/app">Bookmarks</a>
            <a href="/app/bookmarks/new">Add</a>
            <a href="/app/tags">Tags</a>
            <a href="/app/smart-views">Smart Views</a>
            <a href="/app/settings">Settings</a>
            #if(appIsAdmin):<a href="/admin">Dashboard</a>#endif
        </nav>
        <span class="spacer"></span>
        <span class="who">#(appUsername)</span>
        <form method="post" action="/app/logout">
            <button class="secondary" type="submit">Log out</button>
        </form>
    </header>
    #endif
    <main>
        #import("content")
    </main>
    #extend("_footer")
</body>
</html>
