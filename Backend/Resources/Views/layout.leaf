<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Stash Admin — #(title)</title>
    <style>
        :root { color-scheme: light dark; }
        * { box-sizing: border-box; }
        body {
            font-family: -apple-system, system-ui, sans-serif;
            line-height: 1.5; margin: 0; color: #1a1a1a; background: #f4f4f5;
        }
        header.nav {
            display: flex; flex-wrap: wrap; align-items: center; gap: 1rem;
            padding: 0.75rem 1.25rem; background: #1a1a1a; color: #fff;
        }
        header.nav a { color: #fff; text-decoration: none; }
        header.nav .brand { font-weight: 700; margin-right: 1rem; }
        header.nav nav { display: flex; gap: 1rem; }
        header.nav nav a:hover { text-decoration: underline; }
        header.nav .spacer { flex: 1; }
        header.nav form { display: flex; align-items: center; gap: 0.5rem; margin: 0; }
        header.nav .who { opacity: 0.75; font-size: 0.9rem; }
        main { max-width: 880px; margin: 1.5rem auto; padding: 0 1.25rem; }
        h1 { font-size: 1.5rem; }
        a { color: #0a58ca; }
        table { width: 100%; border-collapse: collapse; background: #fff; }
        th, td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid #e4e4e7; }
        th { background: #fafafa; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.03em; }
        .card { background: #fff; border: 1px solid #e4e4e7; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.25rem; }
        .stats { display: flex; gap: 1rem; flex-wrap: wrap; }
        .stat { flex: 1; min-width: 140px; background: #fff; border: 1px solid #e4e4e7; border-radius: 8px; padding: 1rem; }
        .stat .num { font-size: 2rem; font-weight: 700; }
        .stat .label { color: #71717a; font-size: 0.85rem; }
        label { display: block; margin-bottom: 0.75rem; font-weight: 600; }
        input { display: block; width: 100%; padding: 0.5rem; margin-top: 0.25rem; border: 1px solid #d4d4d8; border-radius: 6px; font: inherit; }
        button { font: inherit; padding: 0.5rem 0.9rem; border: 0; border-radius: 6px; background: #0a58ca; color: #fff; cursor: pointer; }
        button.secondary { background: #52525b; }
        button.danger { background: #b91c1c; }
        form.inline { display: inline; margin: 0; }
        .pill { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 999px; font-size: 0.8rem; }
        .pill.active { background: #dcfce7; color: #166534; }
        .pill.suspended { background: #fee2e2; color: #991b1b; }
        .banner { padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
        .banner.error { background: #fee2e2; color: #991b1b; }
        .banner.ok { background: #dcfce7; color: #166534; }
        .muted { color: #71717a; }
        .actions { display: flex; flex-direction: column; gap: 1rem; max-width: 420px; }
    </style>
</head>
<body>
    #if(adminUsername):
    <header class="nav">
        <a href="/admin" class="brand">Stash Admin</a>
        <nav>
            <a href="/admin">Dashboard</a>
            <a href="/admin/users">Users</a>
            <a href="/admin/users/new">New user</a>
        </nav>
        <span class="spacer"></span>
        <span class="who">#(adminUsername)</span>
        <form method="post" action="/admin/logout">
            <button class="secondary" type="submit">Log out</button>
        </form>
    </header>
    #endif
    <main>
        #import("content")
    </main>
</body>
</html>
