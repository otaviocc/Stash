<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Apply the saved theme before any CSS/paint to avoid a flash of the wrong theme. -->
    <script>
    (function () {
        var m = document.cookie.match(/(?:^|; )stash_theme=([^;]+)/);
        if (m && (m[1] === 'dark' || m[1] === 'light')) {
            document.documentElement.setAttribute('data-theme', m[1]);
        }
    })();
    </script>
    <title>#if(adminUsername):Stash Admin#else:Stash#endif — #(title)</title>
    <style>
        /* Light theme (default) */
        :root {
            color-scheme: light;
            --bg: #f4f4f5;
            --text: #1a1a1a;
            --text-muted: #71717a;
            --text-2: #3f3f46;
            --surface: #ffffff;
            --surface-2: #fafafa;
            --border: #e4e4e7;
            --border-input: #d4d4d8;
            --nav-bg: #1a1a1a;
            --nav-text: #ffffff;
            --accent: #0a58ca;
            --btn-text: #ffffff;
            --btn-secondary: #52525b;
            --danger: #b91c1c;
            --url: #16a34a;
            --tag-bg: #e4e4e7;
            --tag-hover: #d4d4d8;
            --ok-bg: #dcfce7;
            --ok-text: #166534;
            --err-bg: #fee2e2;
            --err-text: #991b1b;
            --dz-bg: #fff5f5;
            --dz-border: #fecaca;
            --dz-heading: #b91c1c;
            --shadow: rgba(0, 0, 0, 0.12);
        }
        /* Explicit dark */
        [data-theme="dark"] {
            color-scheme: dark;
            --bg: #1c1c1e;
            --text: #f2f2f7;
            --text-muted: #aeaeb2;
            --text-2: #c7c7cc;
            --surface: #2c2c2e;
            --surface-2: #3a3a3c;
            --border: #3a3a3c;
            --border-input: #48484a;
            --nav-bg: #000000;
            --nav-text: #f2f2f7;
            --accent: #0a84ff;
            --btn-text: #ffffff;
            --btn-secondary: #48484a;
            --danger: #ff453a;
            --url: #30d158;
            --tag-bg: #3a3a3c;
            --tag-hover: #48484a;
            --ok-bg: #1c3a2a;
            --ok-text: #30d158;
            --err-bg: #3a1f1f;
            --err-text: #ff6961;
            --dz-bg: #2a1d1f;
            --dz-border: #5c2b2b;
            --dz-heading: #ff6961;
            --shadow: rgba(0, 0, 0, 0.5);
        }
        [data-theme="light"] { color-scheme: light; }
        /* Auto: follow the OS when no explicit choice is set */
        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]):not([data-theme="dark"]) {
                color-scheme: dark;
                --bg: #1c1c1e;
                --text: #f2f2f7;
                --text-muted: #aeaeb2;
                --text-2: #c7c7cc;
                --surface: #2c2c2e;
                --surface-2: #3a3a3c;
                --border: #3a3a3c;
                --border-input: #48484a;
                --nav-bg: #000000;
                --nav-text: #f2f2f7;
                --accent: #0a84ff;
                --btn-text: #ffffff;
                --btn-secondary: #48484a;
                --danger: #ff453a;
                --url: #30d158;
                --tag-bg: #3a3a3c;
                --tag-hover: #48484a;
                --ok-bg: #1c3a2a;
                --ok-text: #30d158;
                --err-bg: #3a1f1f;
                --err-text: #ff6961;
                --dz-bg: #2a1d1f;
                --dz-border: #5c2b2b;
                --dz-heading: #ff6961;
                --shadow: rgba(0, 0, 0, 0.5);
            }
        }

        * { box-sizing: border-box; }
        body {
            font-family: -apple-system, system-ui, sans-serif;
            line-height: 1.5; margin: 0; color: var(--text); background: var(--bg);
        }
        header.nav {
            display: flex; flex-wrap: wrap; align-items: center; gap: 1rem;
            padding: 0.75rem 1.25rem; background: var(--nav-bg); color: var(--nav-text);
        }
        header.nav a { color: var(--nav-text); text-decoration: none; }
        header.nav .brand { font-weight: 700; margin-right: 1rem; }
        header.nav nav { display: flex; gap: 1rem; }
        header.nav nav a:hover { text-decoration: underline; }
        header.nav .spacer { flex: 1; }
        header.nav form { display: flex; align-items: center; gap: 0.5rem; margin: 0; }
        header.nav .who { opacity: 0.75; font-size: 0.9rem; }
        main { max-width: 880px; margin: 1.5rem auto; padding: 0 1.25rem; }
        h1 { font-size: 1.5rem; }
        a { color: var(--accent); }
        table { width: 100%; border-collapse: collapse; background: var(--surface); }
        th, td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); }
        th { background: var(--surface-2); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.03em; }
        .card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; margin-bottom: 1.25rem; }
        .stats { display: flex; gap: 1rem; flex-wrap: wrap; }
        .stat { flex: 1; min-width: 140px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; }
        .stat .num { font-size: 2rem; font-weight: 700; }
        .stat .label { color: var(--text-muted); font-size: 0.85rem; }
        label { display: block; margin-bottom: 0.75rem; font-weight: 600; }
        input, textarea, select { background: var(--surface); color: var(--text); border: 1px solid var(--border-input); border-radius: 6px; font: inherit; }
        input { display: block; width: 100%; padding: 0.5rem; margin-top: 0.25rem; }
        textarea { width: 100%; padding: 0.5rem; margin-top: 0.25rem; }
        select { padding: 0.5rem; }
        button { font: inherit; padding: 0.5rem 0.9rem; border: 0; border-radius: 6px; background: var(--accent); color: var(--btn-text); cursor: pointer; }
        button.secondary { background: var(--btn-secondary); }
        button.danger { background: var(--danger); }
        button:disabled { opacity: 0.5; cursor: not-allowed; }
        form.inline { display: inline; margin: 0; }
        .pill { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 999px; font-size: 0.8rem; }
        .pill.active { background: var(--ok-bg); color: var(--ok-text); }
        .pill.suspended { background: var(--err-bg); color: var(--err-text); }
        .banner { padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
        .banner.error { background: var(--err-bg); color: var(--err-text); }
        .banner.ok { background: var(--ok-bg); color: var(--ok-text); }
        .muted { color: var(--text-muted); }
        .actions { display: flex; flex-direction: column; gap: 1rem; max-width: 420px; }
        .list-item { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin-bottom: 0.75rem; }
        .list-item h3 { margin: 0 0 0.2rem; font-size: 1.05rem; }
        .list-item h3 a { color: var(--text); text-decoration: none; }
        .list-item .url { color: var(--url); font-size: 0.85rem; word-break: break-all; }
        .list-item .desc { margin: 0.4rem 0 0; color: var(--text-2); }
        .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; }
        .tag { display: inline-block; padding: 0.1rem 0.55rem; border-radius: 999px; background: var(--tag-bg); color: var(--text-2); font-size: 0.8rem; text-decoration: none; }
        .tag:hover { background: var(--tag-hover); }
        .row-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem; }
        .pagination { display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; gap: 1rem; }
        .toolbar { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; margin-bottom: 1rem; }
        .toolbar form { display: flex; gap: 0.5rem; align-items: center; margin: 0; }
        .toolbar input { display: inline-block; width: auto; margin: 0; }
        .codes { font-family: ui-monospace, monospace; font-size: 1.1rem; line-height: 1.9; }
        .key { font-family: ui-monospace, monospace; background: var(--tag-bg); padding: 0.2rem 0.4rem; border-radius: 4px; word-break: break-all; }
        .tag-field { position: relative; display: block; }
        .tag-suggest { position: absolute; left: 0; right: 0; top: 100%; z-index: 20; display: none; background: var(--surface); border: 1px solid var(--border-input); border-radius: 6px; margin-top: 2px; max-height: 220px; overflow-y: auto; box-shadow: 0 4px 12px var(--shadow); }
        .tag-suggest-item { padding: 0.4rem 0.6rem; cursor: pointer; font-size: 0.9rem; }
        .tag-suggest-item:hover, .tag-suggest-item.active { background: var(--tag-bg); }
        .danger-zone { border-color: var(--dz-border); background: var(--dz-bg); }
        .danger-zone h2 { color: var(--dz-heading); margin-top: 0; }
        .app-layout { display: flex; gap: 1.5rem; align-items: flex-start; }
        .app-main { flex: 1; min-width: 0; }
        .tag-sidebar { flex: 0 0 220px; position: sticky; top: 1.5rem; }
        .tag-sidebar h2 { font-size: 1rem; margin: 0 0 0.5rem; }
        .tag-tree { list-style: none; margin: 0; padding: 0; }
        .tag-tree li { margin: 0; line-height: 1.7; }
        .tag-tree a { text-decoration: none; color: var(--text); }
        .tag-tree a:hover { text-decoration: underline; }
        .tag-tree a.active { font-weight: 700; color: var(--accent); }
        .tag-tree .count { color: var(--text-muted); font-size: 0.85rem; }
        @media (max-width: 767px) { .tag-sidebar { display: none; } }
    </style>
</head>
<body>
    #if(adminUsername):
    <header class="nav">
        <a href="/admin" class="brand">Stash Admin</a>
        <nav>
            <a href="/admin">Dashboard</a>
            <a href="/admin/users">Users</a>
            <a href="/admin/users/new">New user</a>
        </nav>
        <span class="spacer"></span>
        <span class="who">#(adminUsername)</span>
        <form method="post" action="/admin/logout">
            <button class="secondary" type="submit">Log out</button>
        </form>
    </header>
    #endif
    #if(appUsername):
    <header class="nav">
        <a href="/app" class="brand">Stash</a>
        <nav>
            <a href="/app">Bookmarks</a>
            <a href="/app/bookmarks/new">Add</a>
            <a href="/app/tags">Tags</a>
            <a href="/app/settings">Settings</a>
        </nav>
        <span class="spacer"></span>
        <span class="who">#(appUsername)</span>
        <form method="post" action="/app/logout">
            <button class="secondary" type="submit">Log out</button>
        </form>
    </header>
    #endif
    <main>
        #import("content")
    </main>
    <script>
    // Dependency-free tag autocomplete for inputs carrying data-known-tags (a JSON array).
    document.querySelectorAll('input[data-known-tags]').forEach(function (input) {
        var known = [];
        try { known = JSON.parse(input.getAttribute('data-known-tags')) || []; } catch (e) { return; }
        if (!known.length) return;
        var box = document.createElement('div');
        box.className = 'tag-suggest';
        input.insertAdjacentElement('afterend', box);
        var active = -1;
        function segIndex() { return input.value.slice(0, input.selectionStart).split(',').length - 1; }
        function choose(tag) {
            var segs = input.value.split(',');
            segs[segIndex()] = (segIndex() > 0 ? ' ' : '') + tag;
            input.value = segs.join(',') + ', ';
            box.style.display = 'none';
            input.focus();
            input.setSelectionRange(input.value.length, input.value.length);
        }
        function render() {
            var frag = (input.value.split(',')[segIndex()] || '').trim().toLowerCase();
            box.innerHTML = ''; active = -1;
            var hits = frag ? known.filter(function (t) { return t.indexOf(frag) === 0 && t !== frag; }).slice(0, 8) : [];
            if (!hits.length) { box.style.display = 'none'; return; }
            hits.forEach(function (t) {
                var el = document.createElement('div');
                el.className = 'tag-suggest-item';
                el.textContent = t;
                el.addEventListener('mousedown', function (e) { e.preventDefault(); choose(t); });
                box.appendChild(el);
            });
            box.style.display = 'block';
        }
        input.addEventListener('input', render);
        input.addEventListener('keydown', function (e) {
            var items = box.querySelectorAll('.tag-suggest-item');
            if (box.style.display === 'none' || !items.length) return;
            if (e.key === 'ArrowDown') { active = Math.min(active + 1, items.length - 1); }
            else if (e.key === 'ArrowUp') { active = Math.max(active - 1, 0); }
            else if (e.key === 'Escape') { box.style.display = 'none'; return; }
            else if ((e.key === 'Enter' || e.key === 'Tab') && active >= 0) { choose(items[active].textContent); e.preventDefault(); return; }
            else return;
            e.preventDefault();
            items.forEach(function (it, j) { it.classList.toggle('active', j === active); });
        });
        input.addEventListener('blur', function () { setTimeout(function () { box.style.display = 'none'; }, 150); });
    });
    </script>
</body>
</html>
