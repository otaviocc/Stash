#extend("layout"):
#export("css"):
    <link rel="stylesheet" href="/css/smart-view-form.css">
#endexport
#export("scripts"):
    <script defer src="/js/smart-view-form.js"></script>
#endexport
#export("content"):
    <h1>#(title)</h1>

    #if(error):
    <p class="banner error">#(error)</p>
    #endif

    <div class="card">
        <form method="post" action="#(action)">
            <label>Name
                <input name="name" value="#(name)" maxlength="100" autocomplete="off" required>
            </label>

            <label for="match-mode">Match
                <select name="matchMode" id="match-mode" style="display:inline; width:auto;">
                    <option value="all"#if(matchMode == "all"): selected#endif>all</option>
                    <option value="any"#if(matchMode == "any"): selected#endif>any</option>
                </select>
                of the following rules:
            </label>
            <div id="cond-list" data-known-tags='#(knownTagsJSON)'>
                #for(c in conditions):
                <div class="cond-row">
                    <select name="conditionType[]" class="cond-type">
                        <option value="tag"#if(c.type == "tag"): selected#endif>Tag</option>
                        <option value="urlContains"#if(c.type == "urlContains"): selected#endif>URL contains</option>
                        <option value="titleContains"#if(c.type == "titleContains"): selected#endif>Title contains</option>
                        <option value="descriptionContains"#if(c.type == "descriptionContains"): selected#endif>Description contains</option>
                        <option value="createdBefore"#if(c.type == "createdBefore"): selected#endif>Created before</option>
                        <option value="createdAfter"#if(c.type == "createdAfter"): selected#endif>Created after</option>
                        <option value="isArchived"#if(c.type == "isArchived"): selected#endif>Is archived</option>
                        <option value="hasTags"#if(c.type == "hasTags"): selected#endif>Has tags</option>
                    </select>
                    <input name="conditionValue[]" class="cond-value-text" type="#if(c.isDate):date#else:text#endif" value="#(c.textValue)" autocomplete="off"#if(c.isBool): disabled style="display:none"#endif>
                    <select name="conditionValue[]" class="cond-value-bool"#if(c.isText): disabled style="display:none"#endif>
                        <option value="true"#if(c.boolValue == "true"): selected#endif>Yes</option>
                        <option value="false"#if(c.boolValue == "false"): selected#endif>No</option>
                    </select>
                    <button type="button" class="secondary cond-remove" aria-label="Remove condition">×</button>
                </div>
                #endfor
            </div>
            <p><button type="button" id="cond-add" class="secondary">Add condition</button></p>

            <div style="display:flex; gap:0.75rem; margin-top:0.5rem;">
                <button type="submit">Save</button>
                <a href="/app/smart-views"><button type="button" class="secondary">Cancel</button></a>
            </div>
        </form>
    </div>

    <template id="cond-template">
        <div class="cond-row">
            <select name="conditionType[]" class="cond-type">
                <option value="tag">Tag</option>
                <option value="urlContains">URL contains</option>
                <option value="titleContains">Title contains</option>
                <option value="descriptionContains">Description contains</option>
                <option value="createdBefore">Created before</option>
                <option value="createdAfter">Created after</option>
                <option value="isArchived">Is archived</option>
                <option value="hasTags">Has tags</option>
            </select>
            <input name="conditionValue[]" class="cond-value-text" type="text" value="" autocomplete="off">
            <select name="conditionValue[]" class="cond-value-bool" disabled style="display:none">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
            <button type="button" class="secondary cond-remove" aria-label="Remove condition">×</button>
        </div>
    </template>

#endexport
#endextend
