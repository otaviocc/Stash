<footer class="site-footer">
    #if(chrome.aboutText):
    <p class="about">#(chrome.aboutText)</p>
    #endif
    <div class="footer-row">
        <div class="footer-links">
            #for(link in chrome.footer.links):
            <a href="#(link.url)" target="_blank" rel="noopener noreferrer">#(link.label)</a>
            #endfor
        </div>
        <span class="version">Stash #(chrome.footer.version)</span>
    </div>
</footer>
