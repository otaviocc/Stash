#extend("layout"):
#export("scripts"):
    <script defer src="/js/appearance.js"></script>
#endexport
#export("content"):
    <h1>Appearance</h1>
    <p class="muted">Personalise this Stash instance.</p>

    #if(message):
    <p class="banner ok">#(message)</p>
    #endif
    #if(error):
    <p class="banner error">#(error)</p>
    #endif

    <form method="post" action="/admin/appearance">
        <div class="card">
            <h2>Accent theme</h2>
            <p class="muted">The accent color used across the admin dashboard and the user app.</p>
            <div class="theme-grid">
                #for(theme in themes):
                <label class="theme-option" title="#(theme.name)">
                    <input type="radio" name="accentTheme" value="#(theme.id)"#if(theme.isSelected): checked#endif>
                    <span class="theme-swatch" style="--swatch-light: #(theme.light); --swatch-dark: #(theme.dark);"></span>
                    <span class="theme-name">#(theme.name)</span>
                </label>
                #endfor
            </div>
        </div>

        <div class="card">
            <h2>About this instance</h2>
            <label>Message
                <textarea name="aboutText" id="aboutText" rows="3" maxlength="280"
                    placeholder="A short message about this instance, shown in the footer. Max 280 characters."
                    oninput="document.getElementById('aboutCount').textContent = this.value.length">#(aboutText)</textarea>
            </label>
            <p class="muted"><span id="aboutCount">0</span> / 280</p>
        </div>

        <div class="card">
            <h2>Footer links</h2>
            <p class="muted">Links shown in the footer. Leave both fields empty to hide a link. All URLs must start with https://.</p>
            <div class="footer-link-row">
                <label>Label
                    <input name="footerLink0Label" value="#(footerLink0Label)" placeholder="GitHub">
                </label>
                <label>URL
                    <input name="footerLink0URL" type="url" value="#(footerLink0URL)" placeholder="https://github.com/...">
                </label>
            </div>
            <div class="footer-link-row">
                <label>Label
                    <input name="footerLink1Label" value="#(footerLink1Label)" placeholder="Mastodon">
                </label>
                <label>URL
                    <input name="footerLink1URL" type="url" value="#(footerLink1URL)" placeholder="https://social.lol/@...">
                </label>
            </div>
            <div class="footer-link-row">
                <label>Label
                    <input name="footerLink2Label" value="#(footerLink2Label)" placeholder="Ko-fi">
                </label>
                <label>URL
                    <input name="footerLink2URL" type="url" value="#(footerLink2URL)" placeholder="https://ko-fi.com/...">
                </label>
            </div>
            <div class="footer-link-row">
                <label>Label
                    <input name="footerLink3Label" value="#(footerLink3Label)" placeholder="Custom link">
                </label>
                <label>URL
                    <input name="footerLink3URL" type="url" value="#(footerLink3URL)" placeholder="https://example.com">
                </label>
            </div>
        </div>

        <button type="submit">Save appearance</button>
    </form>

#endexport
#endextend
