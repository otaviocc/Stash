#extend("layout"):
#export("css"):
    <link rel="stylesheet" href="/css/landing.css">
#endexport
#export("content"):
    <section class="landing-hero">
        <h1>Your bookmarks. Your server. Your data.</h1>
        <p class="lead">Stash is a self-hosted bookmark manager with native iOS, macOS, and web clients.</p>
        <div class="landing-cta">
            <a class="primary" href="/app">Sign in &rarr;</a>
            <a class="secondary" href="/admin">Admin &rarr;</a>
        </div>
    </section>
    #if(aboutText):
    <div class="card landing-about">
        <span class="label">About this instance:</span> #(aboutText)
    </div>
    #endif
    <section class="features">
        <div class="feature">
            <div class="icon">🔒</div>
            <h3>Self-hosted</h3>
            <p>Your data lives on your infrastructure. No third-party cloud, no tracking, no ads.</p>
        </div>
        <div class="feature">
            <div class="icon">🖥️</div>
            <h3>Multi-platform</h3>
            <p>Native iOS and macOS apps, a full web interface, and a command-line tool.</p>
        </div>
        <div class="feature">
            <div class="icon">🗂️</div>
            <h3>Organised</h3>
            <p>Hierarchical tags, full-text search, bulk rename and delete, and Smart Views.</p>
        </div>
        <div class="feature">
            <div class="icon">👥</div>
            <h3>Multi-user</h3>
            <p>Invite others to your instance. Each user has their own private collection.</p>
        </div>
    </section>
#endexport
#endextend
