#extend("layout"):
#export("css"):
    <link rel="stylesheet" href="/css/tags.css">
#endexport
#export("content"):
    <h1>Tags</h1>

    #if(message):
    <p class="banner ok">#(message)</p>
    #endif
    #if(error):
    <p class="banner error">#(error)</p>
    #endif

    <p class="muted">Tags applied to your bookmarks. They appear in the sidebar on the bookmark list.
        Renaming a tag moves all its children with it.</p>

    #if(count(tags) > 0):
    <div class="card">
        <table class="tag-table">
            <thead>
                <tr><th>Tag</th><th>Bookmarks</th><th>Actions</th></tr>
            </thead>
            <tbody>
                #for(t in tags):
                <tr class="tag-row">
                    <td><a href="/app?tag=#(t.name)">#(t.display)</a></td>
                    <td class="muted">#(t.count)</td>
                    <td>
                        <span class="tag-actions">
                            <a href="#" class="rename-toggle">Rename</a>
                            <form class="inline" method="post" action="/app/tags/delete"
                                  onsubmit="return confirm('Delete this tag and all its children? This cannot be undone.');">
                                <input type="hidden" name="tag" value="#(t.name)">
                                <button type="submit" class="secondary">Delete</button>
                            </form>
                        </span>
                        <form class="tag-rename-form" method="post" action="/app/tags/rename" style="display:none">
                            <input type="hidden" name="from" value="#(t.name)">
                            <input name="to" value="#(t.name)" autocomplete="off" autocapitalize="none" required>
                            <button type="submit">Save</button>
                            <button type="button" class="secondary rename-cancel">Cancel</button>
                        </form>
                    </td>
                </tr>
                #endfor
            </tbody>
        </table>
    </div>
    #else:
    <div class="card"><p class="muted">No tags yet.</p></div>
    #endif

    <script>
    // Reveal/hide the inline rename form per tag row. Delete uses a native confirm dialog on
    // submit (same pattern as deleting a bookmark), so it never mutates the table in place.
    document.querySelectorAll('.tag-row').forEach(function (row) {
        var actions = row.querySelector('.tag-actions');
        var renameForm = row.querySelector('.tag-rename-form');
        var input = renameForm.querySelector('input[name="to"]');
        function reset() {
            renameForm.style.display = 'none';
            actions.style.display = '';
        }
        row.querySelector('.rename-toggle').addEventListener('click', function (event) {
            event.preventDefault();
            actions.style.display = 'none';
            renameForm.style.display = 'flex';
            input.focus();
            input.select();
        });
        row.querySelector('.rename-cancel').addEventListener('click', reset);
    });
    </script>
#endexport
#endextend
