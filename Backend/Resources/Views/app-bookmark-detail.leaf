#extend("layout"):
#export("content"):
    <p class="muted"><a href="/app">← Back to bookmarks</a></p>
    #if(message):
    <p class="banner ok">#(message)</p>
    #endif
    #if(error):
    <p class="banner error">#(error)</p>
    #endif

    <h1 class="detail-title">#if(bookmark.faviconDomain):<img src="/api/v1/favicons/#(bookmark.faviconDomain)" alt="" class="favicon favicon-lg" onerror="this.style.display='none'">#endif#(bookmark.title)</h1>

    <div class="card">
        <p class="url"><a href="#(bookmark.url)" target="_blank" rel="noopener">#(bookmark.url)</a></p>
        #if(bookmark.description):<p>#(bookmark.description)</p>#endif
        #if(count(bookmark.tags) > 0):
        <div class="tags">
            #for(t in bookmark.tags):<a class="tag" href="/app?tag=#(t.name)">#(t.display)</a>#endfor
        </div>
        #endif
        <p class="muted" style="margin-top:0.75rem;">
            Saved #(bookmark.createdAt)
            #if(bookmark.isArchived): · <strong>Archived</strong>#endif
        </p>
    </div>

    <div class="row-actions">
        <a href="#(bookmark.url)" target="_blank" rel="noopener"><button type="button">Open URL</button></a>
        <a href="/app/bookmarks/#(bookmark.id)/edit"><button type="button" class="secondary">Edit</button></a>
    </div>

    <div class="card">
        <h2>Actions</h2>
        <div class="action-list">
            #if(bookmark.faviconDomain):
            <form method="post" action="/app/bookmarks/#(bookmark.id)/refresh-favicon">
                <button type="submit" class="action-row">Refresh favicon</button>
            </form>
            #endif
            #if(chrome.internetArchiveEnabled):
            #if(bookmark.waybackURL):
            <a class="action-row" href="#(bookmark.waybackURL)" target="_blank" rel="noopener">View on Wayback Machine</a>
            #endif
            <form method="post" action="/app/bookmarks/#(bookmark.id)/save-to-wayback">
                <button type="submit" class="action-row">Save to Wayback Machine</button>
            </form>
            #endif
            #if(bookmark.isArchived):
            <form method="post" action="/app/bookmarks/#(bookmark.id)/unarchive">
                <button type="submit" class="action-row">Unarchive</button>
            </form>
            #else:
            <form method="post" action="/app/bookmarks/#(bookmark.id)/archive">
                <button type="submit" class="action-row">Archive</button>
            </form>
            #endif
        </div>
    </div>

    <div class="card danger-zone">
        <h2>Danger zone</h2>
        <form method="post" action="/app/bookmarks/#(bookmark.id)/delete"
              onsubmit="return confirm('Delete this bookmark? This cannot be undone.');">
            <button type="submit" class="danger">Delete</button>
        </form>
    </div>
#endexport
#endextend
