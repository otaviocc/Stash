#extend("layout"):
#export("content"):
    <h1>Dashboard</h1>

    #if(updateBanner):
    <p class="banner ok">
        #(updateBanner)
        #if(updateReleaseURL):
        <a href="#(updateReleaseURL)" target="_blank" rel="noopener noreferrer">Release notes</a>
        #endif
        — see <a href="/admin/health">Health</a> for upgrade instructions.
    </p>
    #endif

    <div class="stats">
        <div class="stat">
            <div class="num">#(totalUsers)</div>
            <div class="label">Users (#(activeUsers) active, #(suspendedUsers) suspended)</div>
        </div>
        <div class="stat">
            <div class="num">#(totalBookmarks)</div>
            <div class="label">Bookmarks</div>
        </div>
        <div class="stat">
            <div class="num">#(liveSessions)</div>
            <div class="label">Live sessions</div>
        </div>
        <div class="stat">
            <div class="num">#(archiveQueued)</div>
            <div class="label">Archive queued</div>
        </div>
    </div>

    <h2>Manage</h2>
    <div class="card-grid">
        #for(card in cards):
        <a class="dash-card" href="#(card.href)">
            <h3>#(card.title)</h3>
            <p>#(card.description)</p>
            #if(card.detail):
            <span class="detail">#(card.detail)</span>
            #endif
        </a>
        #endfor
    </div>

    <h2>Recent activity</h2>
    <div class="card">
        #if(recentActivity):
        <table>
            <thead>
                <tr><th>Time</th><th>Actor</th><th>Action</th><th>Detail</th></tr>
            </thead>
            <tbody>
                #for(entry in recentActivity):
                <tr>
                    <td>#(entry.time)</td>
                    <td>#(entry.actor)</td>
                    <td>#(entry.action)</td>
                    <td>#(entry.detail)</td>
                </tr>
                #endfor
            </tbody>
        </table>
        #else:
        <p class="muted">No activity yet.</p>
        #endif
    </div>
#endexport
#endextend
