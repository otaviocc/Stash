#extend("layout"):
#export("content"):
    <h1>Dashboard</h1>
    <div class="stats">
        <div class="stat">
            <div class="num">#(totalUsers)</div>
            <div class="label">Users</div>
        </div>
        <div class="stat">
            <div class="num">#(totalBookmarks)</div>
            <div class="label">Bookmarks</div>
        </div>
    </div>

    <h2>Per-user counts</h2>
    <table>
        <thead>
            <tr><th>Username</th><th>Role</th><th>Status</th><th>Bookmarks</th></tr>
        </thead>
        <tbody>
            #for(user in users):
            <tr>
                <td><a href="/admin/users/#(user.id)">#(user.username)</a></td>
                <td>#(user.role)</td>
                <td>
                    #if(user.isActive):<span class="pill active">Active</span>
                    #else:<span class="pill suspended">Suspended</span>#endif
                </td>
                <td>#(user.bookmarkCount)</td>
            </tr>
            #endfor
        </tbody>
    </table>
#endexport
#endextend
