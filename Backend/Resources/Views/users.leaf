#extend("layout"):
#export("content"):
    <h1>Users</h1>
    <p><a href="/admin/users/new">+ New user</a></p>
    <table>
        <thead>
            <tr><th>Username</th><th>Role</th><th>Status</th><th>Bookmarks</th><th></th></tr>
        </thead>
        <tbody>
            #for(user in users):
            <tr>
                <td>#(user.username)</td>
                <td>#(user.role)</td>
                <td>
                    #if(user.isActive):<span class="pill active">Active</span>
                    #else:<span class="pill suspended">Suspended</span>#endif
                </td>
                <td>#(user.bookmarkCount)</td>
                <td><a href="/admin/users/#(user.id)">Manage</a></td>
            </tr>
            #endfor
        </tbody>
    </table>
#endexport
#endextend
