#extend("layout"):
#export("content"):
    <h1>Edit bookmark</h1>
    <p class="muted"><a href="/app/bookmarks/#(id)">← Back to bookmark</a></p>

    #if(error):
    <p class="banner error">#(error)</p>
    #endif

    <div class="card">
        <p class="url">#(url)</p>
        <form method="post" action="/app/bookmarks/#(id)">
            <label>Title
                <input name="title" value="#(bookmarkTitle)" required>
            </label>
            <label>Description
                <textarea name="description" rows="3">#(description)</textarea>
            </label>
            <label>Tags <span class="muted">(comma or space separated; use / for hierarchy)</span>
                <input name="tags" value="#(tags)">
            </label>
            <label style="font-weight:400;">
                <input type="checkbox" name="archived" value="on" style="display:inline; width:auto;"#if(isArchived): checked#endif>
                Archived
            </label>
            <button type="submit">Save changes</button>
        </form>
    </div>
#endexport
#endextend
