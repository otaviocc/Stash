# Stash environment configuration (Docs/product-deployment.md §18).
#
# Copy this file to `.env` in the same directory as docker-compose.yml, then fill in
# real values. NEVER commit `.env`, it holds secrets.
#
#   cp .env.example .env
#
# docker compose reads these automatically and injects them into the containers.

# PostgreSQL password. Used by both the `db` container (to initialize the database)
# and the `app` container (it is interpolated into DATABASE_URL).
DB_PASSWORD=change-me-to-a-strong-db-password

# Secret used to sign JWT access tokens. Must be random and at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Admin account, created automatically on first boot only. Once the admin exists,
# these values are ignored on subsequent boots.
ADMIN_USERNAME=admin

# Admin password (first boot only). Minimum 12 characters.
ADMIN_PASSWORD=change-me-min-12-chars
