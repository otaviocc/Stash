// Per-machine signing & identity configuration.
//
// This committed file holds the defaults used on the maintainer's primary machine. To build under a
// different developer account / bundle prefix (e.g. a personal Apple ID), DO NOT edit this file —
// create `Config/Stash.local.xcconfig` (gitignored) overriding the two settings below, e.g.:
//
//     STASH_BUNDLE_PREFIX = com.otaviocc
//     DEVELOPMENT_TEAM = ABCDE12345
//
// `STASH_BUNDLE_PREFIX` is the reverse-DNS organisation prefix (everything before `.stash`). It drives
// every bundle-keyed identifier in lockstep: the app and extension bundle IDs, the App Group (which is
// also the Keychain access group and the shared UserDefaults suite), the background-task identifier,
// and the exported drag-and-drop UTType. The runtime reads it back from the `STBundleBase` Info.plist
// key, so the build settings and the Swift constants can never drift apart.

STASH_BUNDLE_PREFIX = com.example.otavio
DEVELOPMENT_TEAM = ABCDE12345

#include? "Stash.local.xcconfig"
